<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Roceel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlmacenTaller.styles.css" asp-append-version="true" />

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">
    
    <div class="container">
    <!-- Botón para abrir el menú -->
<div class="px-4 py-3 border-b border-slate-700">
    <button id="abrirMenu"
            type="button"
            aria-controls="menuLateral"
            aria-expanded="false"
            class="rounded-lg border border-slate-600 bg-slate-800
                   px-4 py-2 font-semibold text-white
                   hover:bg-slate-700 transition-colors">
        ☰ Menú
    </button>
</div>

<!-- Menú lateral -->
<dialog id="menuLateral"
        aria-labelledby="tituloMenu"
        class="menu-lateral">
    <div class="flex items-center justify-between gap-4
                border-b border-slate-700 p-5">
        <h2 id="tituloMenu" class="text-xl font-bold text-white">
            Roceel
        </h2>

        <button id="cerrarMenu"
                type="button"
                aria-label="Cerrar menú"
                class="rounded-lg px-3 py-2 text-slate-300
                       hover:bg-slate-700 hover:text-white">
            ✕
        </button>
    </div>

    <nav aria-label="Navegación principal" class="space-y-2 p-4">
        <a asp-page="/Index" class="enlace-menu">
            Almacén
        </a>

        <a asp-page="/OrdenTrabajo" class="enlace-menu">
            Órdenes de trabajo
        </a>

        <a asp-page="/Piso" class="enlace-menu">
            Piso móvil
        </a>

        <a asp-page="/Kardex" class="enlace-menu">
            Kardex
        </a>
    </nav>
</dialog>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AlmacenTaller - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
    (() => {
        const menu = document.getElementById("menuLateral");
        const abrir = document.getElementById("abrirMenu");
        const cerrar = document.getElementById("cerrarMenu");

        abrir.addEventListener("click", () => {
            menu.showModal();
            abrir.setAttribute("aria-expanded", "true");
        });

        cerrar.addEventListener("click", () => menu.close());

        menu.addEventListener("click", (evento) => {
            const limites = menu.getBoundingClientRect();

            const fueraDelMenu =
                evento.clientX < limites.left ||
                evento.clientX > limites.right ||
                evento.clientY < limites.top ||
                evento.clientY > limites.bottom;

            if (evento.target === menu && fueraDelMenu) {
                menu.close();
            }
        });

        menu.addEventListener("close", () => {
            abrir.setAttribute("aria-expanded", "false");
            abrir.focus();
        });
    })();
</script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>