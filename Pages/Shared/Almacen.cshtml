<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Roceel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AlmacenTaller.styles.css" asp-append-version="true" />

    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen">
    
    <div class="container">
    <nav aria-label="Navegación principal"
     class="flex flex-wrap gap-2 py-4 mb-4 border-b border-slate-700">

    <a asp-page="/Index"
       class="rounded-lg px-4 py-2 text-sm font-semibold
              text-slate-200 bg-slate-800 hover:bg-slate-700
              transition-colors">
        Almacén
    </a>

    <a asp-page="/OrdenTrabajo"
       class="rounded-lg px-4 py-2 text-sm font-semibold
              text-slate-200 bg-slate-800 hover:bg-slate-700
              transition-colors">
        Órdenes de trabajo
    </a>

    <a asp-page="/Piso"
       class="rounded-lg px-4 py-2 text-sm font-semibold
          text-slate-200 bg-slate-800 hover:bg-slate-700
          transition-colors">
     Piso móvil
    </a>
    <a asp-page="/Kardex"
       class="rounded-lg px-4 py-2 text-sm font-semibold
          text-slate-200 bg-slate-800 hover:bg-slate-700
          transition-colors">
     Kardex
    </a>

</nav>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - AlmacenTaller - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>