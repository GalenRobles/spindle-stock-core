@page
@{
    ViewData["Title"] = "Roceel · Piso móvil";
}

<div class="max-w-lg mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-bold text-white">
            Piso móvil
        </h1>

        <p class="mt-2 text-sm text-slate-400">
            Escanea una ubicación y una refacción para registrar movimientos.
        </p>
    </div>

    <section class="rounded-xl border border-slate-700 bg-slate-800 p-5">
        <h2 class="text-lg font-semibold text-white">
            ¿Qué operación vas a realizar?
        </h2>

        <p class="mt-2 text-sm text-slate-400">
            Selecciona una operación para continuar.
        </p>

        <!-- Pendiente: conectar la selección de operación -->
        <div class="mt-5 grid grid-cols-1 gap-3">
            <button id="operacionRetiro"
                    type="button"
                    class="w-full rounded-xl border border-slate-600
                           bg-slate-900 p-4 text-left text-white
                           hover:border-sky-400 transition-colors
                           focus:outline-none focus:ring-2 focus:ring-sky-400">
                <span class="block text-base font-semibold">
                    Retirar refacción
                </span>
                <span class="mt-1 block text-sm text-slate-400">
                    Registrar la salida de material para una orden de trabajo.
                </span>
            </button>

            <button id="operacionTransferencia"
                    type="button"
                    class="w-full rounded-xl border border-slate-600
                           bg-slate-900 p-4 text-left text-white
                           hover:border-sky-400 transition-colors
                           focus:outline-none focus:ring-2 focus:ring-sky-400">
                <span class="block text-base font-semibold">
                    Transferir refacción
                </span>
                <span class="mt-1 block text-sm text-slate-400">
                    Mover material entre ubicaciones.
                </span>
            </button>

            <button id="operacionConteo"
                    type="button"
                    class="w-full rounded-xl border border-slate-600
                           bg-slate-900 p-4 text-left text-white
                           hover:border-sky-400 transition-colors
                           focus:outline-none focus:ring-2 focus:ring-sky-400">
                <span class="block text-base font-semibold">
                    Contar existencias
                </span>
                <span class="mt-1 block text-sm text-slate-400">
                    Registrar la cantidad física encontrada en una ubicación.
                </span>
            </button>
        </div>
    </section>
</div>