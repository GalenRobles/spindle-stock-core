@page
@model AlmacenTaller.Pages.IndexModel
@{
    ViewData["Title"] = "Catálogo de Piezas";
}

<div class="space-y-6">
    <!-- Header principal -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-slate-700 pb-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-white flex items-center gap-2">
                <span class="inline-block w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
                Roceel - Almacen de Refacciones
            </h1>
            <p class="text-sm text-slate-400">Control de existencias y reservas de refacciones para husillos CNC</p>
        </div>
        <div class="mt-4 md:mt-0 flex items-center gap-3">
            <span id="connectionBadge" class="px-3 py-1 text-xs font-semibold rounded-full bg-slate-800 text-slate-300 border border-slate-700">
                Conectando a SignalR...
            </span>
        </div>
    </div>

 <!-- Barra de KPIs -->
<div class="grid grid-cols-2 xl:grid-cols-4 gap-4">

    <div class="rounded-xl border border-slate-700 bg-slate-800 p-5">
        <p class="text-sm font-medium text-slate-300">
            Refacciones
        </p>
        <p class="mt-3 text-3xl font-bold text-white">
            @Model.Piezas.Count
        </p>
        <p class="mt-2 text-xs text-slate-400">
            Tipos de pieza en catálogo
        </p>
    </div>

    <div class="rounded-xl border border-slate-700 bg-slate-800 p-5">
        <p class="text-sm font-medium text-slate-300">
            Stock físico
        </p>
        <p class="mt-3 text-3xl font-bold text-sky-400">
            @Model.Piezas.Sum(p => p.StockFisico)
        </p>
        <p class="mt-2 text-xs text-slate-400">
            Unidades en almacén
        </p>
    </div>

    <div class="rounded-xl border border-slate-700 bg-slate-800 p-5">
        <p class="text-sm font-medium text-slate-300">
            Reservadas
        </p>
        <p class="mt-3 text-3xl font-bold text-amber-400">
            @Model.Piezas.Sum(p => p.Reservado)
        </p>
        <p class="mt-2 text-xs text-slate-400">
            Unidades comprometidas
        </p>
    </div>

    <div class="rounded-xl border border-rose-500/30 bg-rose-500/10 p-5">
        <p class="text-sm font-medium text-rose-200">
            Sin disponibilidad
        </p>
        <p class="mt-3 text-3xl font-bold text-rose-400">
            @Model.Piezas.Count(p => p.Disponible <= 0)
        </p>
        <p class="mt-2 text-xs text-rose-200">
            Refacciones que requieren atención
        </p>
    </div>

</div>

    <!-- Tabla de Refacciones -->
    <div class="bg-slate-800/40 border border-slate-700 rounded-lg overflow-hidden shadow-xl">
        <div class="p-4 border-b border-slate-700/80 bg-slate-800/80 flex justify-between items-center">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-300">Catálogo de Piezas en Taller</h2>
            <span class="text-xs text-slate-400">Datos de PostgreSQL · actualización cada 15 s</span>
        </div>
        <!-- Bloque de busqueda-->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-4 border-b border-slate-700">
    <div class="md:col-span-2">
        <label for="buscarPieza"
               class="block mb-2 text-sm font-medium text-slate-300">
            Buscar refacción
        </label>

        <input id="buscarPieza"
               name="buscarPieza"
               type="search"
               placeholder="SKU, descripción o categoría..."
               class="w-full rounded-lg border border-slate-600 bg-slate-900
                      px-4 py-3 text-white placeholder-slate-400
                      focus:outline-none focus:ring-2 focus:ring-sky-500" />
    </div>

    <div>
        <label for="filtrarEstado"
               class="block mb-2 text-sm font-medium text-slate-300">
            Estado del inventario
        </label>

        <select id="filtrarEstado"
                name="filtrarEstado"
                class="w-full rounded-lg border border-slate-600 bg-slate-900
                       px-4 py-3 text-white
                       focus:outline-none focus:ring-2 focus:ring-sky-500">
            <option value="">Todos los estados</option>
            <option value="critico">Sin disponibilidad</option>
            <option value="bajo">Stock bajo</option>
            <option value="optimo">Stock suficiente</option>
        </select>
    </div>
</div>
        <div class="overflow-x-auto">
            <table class="w-full min-w-[950px] text-left text-sm text-slate-300">
                <thead class="bg-slate-900/60 text-xs uppercase font-medium text-slate-400 border-b border-slate-700">
                    <tr>
                        <th class="px-4 py-3">SKU</th>
                        <th class="px-4 py-3">Descripción</th>
                        <th class="px-4 py-3">Categoría</th>
                        <th scope="col" class="px-4 py-3">Ubicación</th>
                        <th class="px-4 py-3 text-center">Físico</th>
                        <th class="px-4 py-3 text-center">Reservado</th>
                        <th class="px-4 py-3 text-center">Disponible</th>
                        <th class="px-4 py-3 text-center">Estado</th>
                        <th class="px-4 py-3">Reposición</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700/60">
                @if (!Model.Piezas.Any())
                    {
                    <tr>
                        <td colspan="9"
                            class="px-5 py-10 text-center text-slate-400">
                            No hay refacciones para mostrar.
                        </td>
                     </tr>
                    }
                    @foreach (var item in Model.Piezas)
                    {
                        var estadoColor = item.Disponible <= 0 ? "bg-rose-500/20 text-rose-400 border-rose-500/30" :
                                          item.Disponible <= item.StockMinimo ? "bg-amber-500/20 text-amber-300 border-amber-500/30" :
                                          "bg-emerald-500/20 text-emerald-300 border-emerald-500/30";

                        var estadoTexto = item.Disponible <= 0
                                        ? "Sin disponibilidad"
                                        : item.Disponible <= item.StockMinimo
                                        ? "Stock bajo"
                                        : "Disponible";

                        var estadoFiltro = item.Disponible <= 0
                            ? "critico"
                            : item.Disponible <= item.StockMinimo ? "bajo" : "optimo";

                    <tr data-pieza="true" data-id="@item.Id" data-estado="@estadoFiltro" class="hover:bg-slate-700/30 transition-colors">
                        <td class="px-4 py-3 font-mono text-xs font-semibold text-sky-400">
                            @item.Sku
                        </td>

                        <td class="px-4 py-3 font-medium text-white">
                            @item.Nombre
                        </td>

                        <td class="px-4 py-3 text-slate-400">
                            @item.Categoria
                        </td>

                        <td class="px-4 py-3 text-slate-400">
                            @(string.IsNullOrWhiteSpace(item.Ubicacion) ? "Sin ubicación" : item.Ubicacion)
                        </td>

                        <td class="px-4 py-3 text-center font-semibold">
                            @item.StockFisico
                        </td>

                        <td class="px-4 py-3 text-center text-amber-400 font-semibold">
                            @item.Reservado
                        </td>

                        <td class="px-4 py-3 text-center font-bold @(item.Disponible <= 0 ? "text-rose-400" : "text-white")">
                            @item.Disponible
                        </td>

                        <td class="px-4 py-4 text-center">
                            <span class="@estadoColor"
                                style="display: inline-flex;
                                        align-items: center;
                                        justify-content: center;
                                        white-space: nowrap;
                                        padding: 6px 12px;
                                        border: 1px solid;
                                        border-radius: 999px;
                                        font-size: 12px;
                                        font-weight: 600;
                                        line-height: 1.2;">
                                @estadoTexto
                            </span>
                        </td>

        <td class="px-4 py-3 text-slate-400 text-xs">
            @item.TiempoReposicion
        </td>
    </tr>                       
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- Faltantes abiertos de PostgreSQL -->
<section class="overflow-hidden rounded-xl border border-slate-700 bg-slate-800">
    <div class="p-5 border-b border-slate-700">
        <h2 class="text-lg font-semibold text-white">
            Faltantes abiertos
        </h2>

        <p class="mt-2 text-sm text-slate-400">
            Refacciones pendientes de conseguir para las órdenes de trabajo.
        </p>
    </div>

    <div id="tablaFaltantes" class="overflow-x-auto">
        <table class="w-full min-w-[750px] text-left text-sm text-slate-300">
            <caption class="sr-only">
                Faltantes de refacciones por orden de trabajo
            </caption>

            <thead class="bg-slate-900/50 text-xs uppercase text-slate-400">
                <tr>
                    <th scope="col" class="px-5 py-4">Refacción</th>
                    <th scope="col" class="px-5 py-4">Orden de trabajo</th>
                    <th scope="col" class="px-5 py-4 text-right">Cantidad faltante</th>
                    <th scope="col" class="px-5 py-4">Fecha de registro (UTC)</th>
                    <th scope="col" class="px-5 py-4">Estado</th>
                </tr>
            </thead>

            <tbody id="filasFaltantes" class="divide-y divide-slate-700">
                @foreach (var faltante in Model.Faltantes)
                {
                    <tr>
                        <td class="px-5 py-4">@faltante.Nombre</td>
                        <td class="px-5 py-4">@faltante.Orden</td>
                        <td class="px-5 py-4 text-right">@(faltante.Cantidad?.ToString() ?? "Por determinar")</td>
                        <td class="px-5 py-4">@faltante.Creado.ToUniversalTime().ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="px-5 py-4">Abierto</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="estadoFaltantes"
         role="status"
         aria-live="polite"
         class="px-5 py-8 text-center text-sm text-slate-400">
        @(Model.Faltantes.Count == 0 ? "No hay faltantes abiertos registrados." : $"{Model.Faltantes.Count} faltantes abiertos registrados.")
    </div>
</section>
<!-- Sugerencias activas de PostgreSQL -->
<section class="overflow-hidden rounded-xl border border-slate-700 bg-slate-800">
    <div class="p-5 border-b border-slate-700">
        <h2 class="text-lg font-semibold text-white">
            Sugerencias de compra
        </h2>

        <p class="mt-2 text-sm text-slate-400">
            Reposición sugerida según faltantes y niveles de inventario.
        </p>
    </div>

    <div id="tablaCompras" class="overflow-x-auto">
        <table class="w-full min-w-[850px] text-left text-sm text-slate-300">
            <caption class="sr-only">
                Sugerencias de compra de refacciones
            </caption>

            <thead class="bg-slate-900/50 text-xs uppercase text-slate-400">
                <tr>
                    <th scope="col" class="px-5 py-4">Refacción</th>
                    <th scope="col" class="px-5 py-4 text-right">
                        Cantidad sugerida
                    </th>
                    <th scope="col" class="px-5 py-4">Órdenes relacionadas</th>
                    <th scope="col" class="px-5 py-4">Tiempo de reposición</th>
                    <th scope="col" class="px-5 py-4">Estado</th>
                </tr>
            </thead>

            <tbody id="filasCompras" class="divide-y divide-slate-700">
                @foreach (var compra in Model.Compras)
                {
                    <tr>
                        <td class="px-5 py-4">@compra.Nombre</td>
                        <td class="px-5 py-4 text-right">@compra.Cantidad</td>
                        <td class="px-5 py-4">@(string.IsNullOrWhiteSpace(compra.Ordenes) ? "Sin orden relacionada" : compra.Ordenes)</td>
                        <td class="px-5 py-4">@compra.Reposicion</td>
                        <td class="px-5 py-4">Activa</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div id="estadoCompras"
         role="status"
         aria-live="polite"
         class="px-5 py-8 text-center text-sm text-slate-400">
        @(Model.Compras.Count == 0 ? "No hay sugerencias activas registradas." : $"{Model.Compras.Count} sugerencias activas registradas.")
    </div>
</section>
</div>

<!-- Actualización independiente de las notificaciones del backend -->
@section Scripts {
    <script>
        const search = document.getElementById("buscarPieza");
        const state = document.getElementById("filtrarEstado");
        const badge = document.getElementById("connectionBadge");
        badge.textContent = "Actualización cada 15 s";
        const normalize = value => value.normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "").toLowerCase();
        const saved = sessionStorage.getItem("inventario-filtros");
        if (saved) {
            try {
                const filters = JSON.parse(saved);
                search.value = filters.search || "";
                state.value = filters.state || "";
            } catch (_) { }
        }
        function filterRows() {
            const query = normalize(search.value.trim());
            let shown = 0;
            document.querySelectorAll("tr[data-pieza]").forEach(row => {
                const matches = normalize(row.textContent).includes(query) &&
                    (!state.value || row.dataset.estado === state.value);
                row.hidden = !matches;
                if (matches) shown++;
            });
            document.getElementById("resultadoFiltros").textContent =
                `${shown} refacciones coinciden con los filtros.`;
            sessionStorage.setItem("inventario-filtros", JSON.stringify({
                search: search.value, state: state.value
            }));
        }
        search.addEventListener("input", filterRows);
        state.addEventListener("change", filterRows);
        const summary = document.createElement("p");
        summary.id = "resultadoFiltros";
        summary.className = "px-4 py-2 text-sm text-slate-400";
        summary.setAttribute("role", "status");
        search.closest(".grid").after(summary);
        filterRows();
        const scroll = sessionStorage.getItem("inventario-scroll");
        if (scroll) window.scrollTo(0, Number(scroll));
        setInterval(() => {
            if (document.hidden || document.activeElement === search ||
                document.activeElement === state) return;
            sessionStorage.setItem("inventario-scroll", String(window.scrollY));
            location.reload();
        }, 15000);
    </script>
}
