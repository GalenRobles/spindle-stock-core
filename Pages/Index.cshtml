@page
@model AlmacenTaller.Pages.IndexModel
@{
    ViewData["Title"] = "Catálogo de Piezas";
}

<div class="container mt-4">
    <h2 class="mb-3">Catálogo de Piezas</h2>
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>SKU</th>
                <th>Nombre</th>
                <th>Familia</th>
                <th>Grupo</th>
                <th>Subgrupo</th>
                <th>Activo</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Piezas != null && Model.Piezas.Any())
            {
                @foreach (var item in Model.Piezas)
                {
                    <tr>
                        <td>@item.PartId</td>
                        <td>@item.Sku</td>
                        <td>@item.Name</td>
                        <td>@item.Family</td>
                        <td>@item.Group</td>
                        <td>@item.Subgroup</td>
                        <td>@(item.Active ? "Sí" : "No")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center">No hay piezas registradas aún.</td>
                </tr>
            }
        </tbody>
    </table>
</div>