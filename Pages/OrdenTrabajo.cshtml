@page
@{
    ViewData["Title"] = "Roceel · Orden de trabajo";
}

<div class="space-y-6">
    <div>
        <h1 class="text-2xl md:text-3xl font-bold text-white">
            Orden de trabajo
        </h1>

        <p class="mt-2 text-sm text-slate-400">
            Consulta las refacciones reservadas, entregadas y pendientes de una orden.
        </p>
    </div>

    <!-- Buscador: pendiente de conectar con la API -->
    <section class="rounded-xl border border-slate-700 bg-slate-800 p-5">
        <label for="codigoOrden"
               class="block mb-2 text-sm font-medium text-slate-300">
            Código de orden de trabajo
        </label>

        <div class="flex flex-col sm:flex-row gap-3">
            <input id="codigoOrden"
                   name="codigoOrden"
                   type="search"
                   placeholder="Ingresa el código de la orden"
                   class="w-full flex-1 rounded-lg border border-slate-600
                          bg-slate-900 px-4 py-3 text-white
                          placeholder-slate-400 focus:outline-none
                          focus:ring-2 focus:ring-sky-500" />

            <button id="buscarOrden"
                    type="button"
                    class="rounded-lg bg-sky-500 px-6 py-3 font-semibold
                           text-slate-950 hover:bg-sky-400 transition-colors
                           focus:outline-none focus:ring-2 focus:ring-sky-300">
                Buscar orden
            </button>
        </div>
    </section>

    <!-- Estado inicial -->
    <section id="estadoInicial"
             class="rounded-xl border border-dashed border-slate-600
                    bg-slate-800/30 px-6 py-12 text-center">
        <h2 class="text-lg font-semibold text-white">
            Consulta una orden de trabajo
        </h2>

        <p class="mt-2 text-sm text-slate-400">
            Ingresa el código para consultar el detalle de sus refacciones.
        </p>
    </section>

    <!-- Mostrar únicamente después de una consulta sin resultados -->
    <section id="sinResultados" hidden
             class="rounded-xl border border-slate-700 bg-slate-800 p-6">
        <h2 class="text-lg font-semibold text-white">
            Orden no encontrada
        </h2>
        <p class="mt-2 text-sm text-slate-400">
            Verifica el código e intenta nuevamente.
        </p>
    </section>

    <!-- Mensajes de carga o error de la consulta -->
    <div id="estadoConsulta" role="status" aria-live="polite"
         class="text-sm text-slate-300"></div>

    <!-- Detalle: mostrar cuando se reciba una orden válida -->
    <section id="detalleOrden" hidden
             class="overflow-hidden rounded-xl border border-slate-700 bg-slate-800">

        <div class="p-5 border-b border-slate-700">
            <p class="text-xs font-semibold uppercase tracking-wide text-sky-400">
                Orden de trabajo
            </p>

            <h2 id="ordenCodigo"
                class="mt-2 text-xl font-bold text-white"></h2>

            <p id="ordenDescripcion"
               class="mt-1 text-sm text-slate-400"></p>

            <p id="ordenEstado"
               class="mt-3 text-sm font-medium text-slate-300"></p>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 p-5">
            <div class="rounded-lg border border-slate-700 bg-slate-900/50 p-4">
                <p class="text-xs text-slate-400">Requeridas</p>
                <p id="totalRequeridas"
                   class="mt-2 text-2xl font-bold text-white"></p>
            </div>

            <div class="rounded-lg border border-slate-700 bg-slate-900/50 p-4">
                <p class="text-xs text-slate-400">Reservadas por entregar</p>
                <p id="totalReservadas"
                   class="mt-2 text-2xl font-bold text-amber-400"></p>
            </div>

            <div class="rounded-lg border border-slate-700 bg-slate-900/50 p-4">
                <p class="text-xs text-slate-400">Entregadas</p>
                <p id="totalEntregadas"
                   class="mt-2 text-2xl font-bold text-emerald-400"></p>
            </div>

            <div class="rounded-lg border border-rose-500/30 bg-rose-500/10 p-4">
                <p class="text-xs text-rose-200">Pendientes de conseguir</p>
                <p id="totalPendientes"
                   class="mt-2 text-2xl font-bold text-rose-400"></p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full min-w-[750px] text-left text-sm text-slate-300">
                <caption class="sr-only">Refacciones de la orden consultada</caption>

                <thead class="bg-slate-900/50 text-xs uppercase text-slate-400">
                    <tr>
                        <th scope="col" class="px-5 py-4">Refacción</th>
                        <th scope="col" class="px-5 py-4 text-center">Requeridas</th>
                        <th scope="col" class="px-5 py-4 text-center">Reservadas por entregar</th>
                        <th scope="col" class="px-5 py-4 text-center">Entregadas</th>
                        <th scope="col" class="px-5 py-4 text-center">Pendientes de conseguir</th>
                    </tr>
                </thead>

                <tbody id="refaccionesOrden" class="divide-y divide-slate-700">
                    <!-- Insertar las filas recibidas al conectar los datos -->
                </tbody>
            </table>
            <div id="ordenSinRefacciones" hidden
     class="px-6 py-10 text-center">
    <h3 class="text-base font-semibold text-white">
        Esta orden no tiene refacciones asignadas
    </h3>

    <p class="mt-2 text-sm text-slate-400">
        Las refacciones aparecerán aquí cuando se agreguen a la orden.
    </p>
</div>
        </div>
    </section>
</div>